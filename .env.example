# FinGuru configuration template.
#
#   cp .env.example .env
#
# Then set JWT_SECRET and FIELD_ENCRYPTION_KEY. The defaults below are safe for
# local development and *refused* in production: `validate_production_settings()`
# runs at startup and the process will not serve with placeholders in place.
#
# Never commit .env. It is in .gitignore for a reason.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=FinGuru
APP_VERSION=3.0.0
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated. Empty + DEBUG=True means "*" for local work. In production
# this must be an explicit list -- credentialed CORS with a wildcard origin is
# rejected by every browser anyway.
CORS_ALLOW_ORIGINS=

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# TWO ROLES, AND THEY ARE NOT INTERCHANGEABLE.
#
#   finguru_app  -- the application. Created NOSUPERUSER NOBYPASSRLS by the
#                   migration, and does not own the tables.
#   finguru      -- the owner. Runs Alembic. Nothing else.
#
# PostgreSQL exempts superusers and table owners from Row-Level Security.
# Pointing DATABASE_URL at the owner silently disables every tenancy policy in
# the schema while all the SQL still looks correct. This is the single easiest
# way to turn this application into the vulnerable one it replaced.
#
# Ports are 55432/56379 so the compose stack cannot collide with a local
# Postgres or Redis -- and so a misconfigured client cannot silently reach the
# wrong database.
DATABASE_URL=postgresql+asyncpg://finguru_app:finguru_app@localhost:55432/finguru
DATABASE_MIGRATION_URL=postgresql+asyncpg://finguru:finguru@localhost:55432/finguru
DB_APP_ROLE=finguru_app
DB_APP_PASSWORD=finguru_app
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=False

# Monthly transaction partitions kept ahead of now.
TXN_PARTITION_LOOKAHEAD_MONTHS=3

# ---------------------------------------------------------------------------
# Redis -- jti denylist, auth rate limiting, LLM token budgets
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:56379/0
# Set true for any multi-worker deployment. The in-process fallback gives each
# worker its own denylist, so a token revoked on one is still accepted by the
# others -- a revocation that does not revoke.
REDIS_REQUIRED=False

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
# REQUIRED. 32+ characters.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# REQUIRED. 32 bytes, base64. Encrypts stored MFA secrets at rest.
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
#
# DO NOT ROTATE without a re-encryption migration: changing it makes every
# enrolled second factor undecryptable and locks MFA users out permanently.
FIELD_ENCRYPTION_KEY=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# Argon2id. Memory-hardness is the entire reason for choosing it over bcrypt:
# each guess must hold ARGON2_MEMORY_COST KiB simultaneously, so a GPU is
# bounded by memory bandwidth rather than core count. Lowering this forfeits
# the property. 65536 = 64 MiB.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
# Auth endpoints are limited separately and harder than general traffic --
# credential stuffing does not look like ordinary use.
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_RATE_LIMIT_PER_HOUR=60
GENERAL_RATE_LIMIT_PER_MINUTE=60
GENERAL_RATE_LIMIT_PER_HOUR=1000

MFA_ISSUER=FinGuru
MFA_TOTP_WINDOW=1
MFA_REQUIRED_FOR_BANK_LINKAGE=True

# ---------------------------------------------------------------------------
# Account Aggregator (RBI / DEPA)
# ---------------------------------------------------------------------------
# SANDBOX ONLY. FinGuru is not an RBI-registered Financial Information User and
# cannot become one -- that requires an RBI-regulated entity. See the README.
AA_ENABLED=True
AA_PROVIDER=setu
AA_BASE_URL=https://fiu-sandbox.setu.co
AA_FIU_ID=finguru-sandbox
AA_CLIENT_ID=
AA_CLIENT_SECRET=
AA_WEBHOOK_SECRET=change-me-to-the-secret-your-aa-issued
AA_SANDBOX_ONLY=True
# True runs the local simulator with real cryptography. Production startup
# refuses this: a deployment silently serving simulated bank data would be
# worse than one that does not start.
AA_USE_MOCK_TRANSPORT=True

# ---------------------------------------------------------------------------
# Machine learning
# ---------------------------------------------------------------------------
MODEL_REGISTRY_DIR=./data/models
CATEGORIZER_BASE_MODEL=google/bert_uncased_L-2_H-128_A-2
# Below this confidence the label becomes "uncategorised" rather than a
# confident guess.
CATEGORIZER_CONFIDENCE_FLOOR=0.45
# Deployment gate. A model scoring below this on the temporal test split must
# not serve; tests/test_categorizer_metrics.py enforces it.
CATEGORIZER_MIN_MACRO_F1=0.80
PSI_ALERT_THRESHOLD=0.2
PSI_RETRAIN_THRESHOLD=0.25

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_REDACTION_ENABLED=True
LLM_INJECTION_DEFENCE_ENABLED=True
# Fail closed. If redaction cannot be verified, do not call the provider at
# all -- a partial send is a full disclosure.
LLM_FAIL_CLOSED_ON_REDACTION_ERROR=True
LLM_USER_DAILY_TOKEN_BUDGET=50000
LLM_MAX_CONTEXT_TRANSACTIONS=25

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=csv
